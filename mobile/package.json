{
  "name": "borrowhood",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:ui:seed": "node .maestro/scripts/seed-maestro-data.js",
    "test:ui:cleanup": "node .maestro/scripts/cleanup-maestro-data.js",
    "test:ui": "sh .maestro/scripts/seed-and-run.sh",
    "test:ui:ios": "maestro test .maestro/flows/ --platform ios",
    "test:ui:screenshots": "maestro test .maestro/flows/ --format junit --output .maestro/screenshots/",
    "test:smoke": "jest --testPathPatterns=smoke --runInBand",
    "test:fix-batch": "jest --runInBand --watch=false --runTestsByPath __tests__/screens/onboarding/OnboardingIntroScreen.test.js __tests__/screens/onboarding/OnboardingTownScreen.test.js __tests__/screens/onboarding/OnboardingVerifyScreen.test.js __tests__/screens/OfferItemScreen.test.js __tests__/screens/ChatScreen.test.js __tests__/screens/BorrowRequestScreen.test.js __tests__/screens/TransactionDetailScreen.test.js __tests__/screens/IdentityVerificationScreen.test.js __tests__/screens/ListingDetailScreen.test.js __tests__/unit/components/ModalControls.test.js __tests__/unit/components/SharingPicker.test.js __tests__/screens/MyItemsScreen.test.js __tests__/screens/RequestDetailScreen.test.js __tests__/screens/CreateListingScreen.test.js __tests__/screens/UserProfileScreen.test.js __tests__/screens/FeedScreen.test.js __tests__/screens/EditListingScreen.test.js",
    "test:components": "jest --testPathPatterns=unit/components --runInBand",
    "test:usability": "npm run test:fix-batch && jest --runInBand --watch=false --runTestsByPath __tests__/unit/draftStorage.test.js __tests__/unit/hooks/useFormDraft.test.js __tests__/unit/requestForm.test.js __tests__/unit/chatExchange.test.js __tests__/unit/components/ChatExchangeCard.test.js __tests__/screens/CreateRequestScreen.test.js __tests__/screens/InboxScreen.test.js __tests__/screens/ProfileScreen.test.js",
    "test:contexts": "jest --testPathPatterns=unit/contexts --runInBand",
    "test:hooks": "jest --testPathPatterns=unit/hooks --runInBand",
    "test:screens:auth": "jest --testPathPatterns=screens/auth --runInBand",
    "test:screens:onboarding": "jest --testPathPatterns=screens/onboarding --runInBand",
    "test:screens:main": "jest --testPathPatterns='screens/(Feed|Saved|MyItems|Inbox|Profile)Screen' --runInBand",
    "test:screens:listings": "jest --testPathPatterns='screens/(Browse|ListingDetail|CreateListing|EditListing|ListingDiscussion|WantedPosts)' --runInBand",
    "test:screens:transactions": "jest --testPathPatterns='screens/(BorrowRequest|CreateRequest|EditRequest|RequestDetail|RentalCheckout|TransactionDetail|DamageClaim)' --runInBand",
    "test:screens:social": "jest --testPathPatterns='screens/(Friends|Chat|Conversations|UserProfile|InviteMembers)' --runInBand",
    "test:screens:community": "jest --testPathPatterns='screens/(MyCommunity|JoinCommunity|CommunitySetting|CommunityLibrary)' --runInBand",
    "test:screens:account": "jest --testPathPatterns='screens/(EditProfile|Subscription|PaymentMethods|AddPaymentMethod|SetupPayout|NotificationSettings)' --runInBand",
    "test:screens:features": "jest --testPathPatterns='screens/(Notifications|Activity|Referral|Disputes|DisputeDetail|IdentityVerification)' --runInBand",
    "test:screens:extras": "jest --testPathPatterns='screens/(Sustainability|Badges|Bundles|LendingCircles)' --runInBand",
    "test:integration": "jest --testPathPatterns=integration --runInBand",
    "test:unit": "jest --testPathPatterns=unit --runInBand",
    "test:screens": "jest --testPathPatterns=screens --runInBand",
    "test:full": "jest --runInBand --timeout=30000",
    "test:all": "npm run test:smoke && jest --runInBand --timeout=30000",
    "dev": "expo start --dev-client --lan --scheme com.borrowhood.app",
    "ui": "node scripts/start-ui.js",
    "ui:mac": "node scripts/start-mac-ui.js"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "base64-js": "^1.5.1",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-contacts": "~58.0.8",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-iap": "3.4.13",
    "expo-image": "~58.0.16",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.6",
    "expo-secure-store": "~58.0.2",
    "expo-sms": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "semver": "^7.7.4",
    "worklets": "^0.0.1-alpha"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/config": "~58.0.7",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0"
  },
  "private": true
}
