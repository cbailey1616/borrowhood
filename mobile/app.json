{
  "expo": {
    "name": "Borrowhood",
    "slug": "borrowhood",
    "scheme": "borrowhood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3EBDD"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.borrowhood.app",
      "buildNumber": "235",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Borrowhood to take photos for your listings and private chats.",
        "NSPhotoLibraryUsageDescription": "Allow Borrowhood to select photos for your listings and private chats.",
        "NSLocationWhenInUseUsageDescription": "Borrowhood can use your current location to suggest your town. You can also enter it yourself.",
        "NSFaceIDUsageDescription": "Allow Borrowhood to use Face ID for secure and quick sign-in.",
        "NSContactsUsageDescription": "Borrowhood uses your contacts to help you find friends who are already on the app.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        },
        "NSLocalNetworkUsageDescription": "Allow Borrowhood to connect to your Mac for live UI previews during development."
      },
      "associatedDomains": [
        "applinks:borrowhood.com"
      ],
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#F3EBDD"
      },
      "package": "com.borrowhood.app",
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#4A7C59"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.borrowhood.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Borrowhood to select photos for your listings and private chats.",
          "cameraPermission": "Allow Borrowhood to take photos for your listings and private chats.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Borrowhood can use your current location to suggest your town. You can also enter it yourself."
        }
      ],
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Borrowhood uses your contacts to help you find friends who are already on the app."
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.676290787470-472asl7h2othaifi7p9pj8bfs7ojo234"
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EBDD",
          "image": "./src/assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7ac93977-f96c-4e47-a9c5-c1802b9ae3d5"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "cbailey1616"
  }
}
