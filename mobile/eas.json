{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug"
      },
      "environment": "development"
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Debug"
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release",
        "autoIncrement": "buildNumber",
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release",
        "autoIncrement": "buildNumber",
        "image": "macos-tahoe-26.6-xcode-27.1"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      }
    },
    "duo-qa": {
      "extends": "preview",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1",
        "simulator": true,
        "buildConfiguration": "Release"
      },
      "environment": "development"
    },
    "launch-qa": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:3101"
      }
    },
    "android-preview": {
      "extends": "preview",
      "environment": "production",
      "android": {
        "buildType": "apk",
        "autoIncrement": "versionCode"
      }
    },
    "android-store": {
      "extends": "production",
      "environment": "production"
    },
    "android-development": {
      "extends": "development-device",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://borrowhood-production.up.railway.app"
      },
      "android": {
        "buildType": "apk",
        "autoIncrement": "versionCode"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appleId": "cbailey1616@gmail.com",
        "ascAppId": "6758581435",
        "appleTeamId": "8H5NL2H27M"
      }
    },
    "production": {
      "ios": {
        "appleId": "cbailey1616@gmail.com",
        "ascAppId": "6758581435",
        "appleTeamId": "8H5NL2H27M"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    },
    "android-store": {
      "android": {
        "track": "internal"
      }
    }
  }
}
